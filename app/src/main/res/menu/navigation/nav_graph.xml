<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_transactions">

    <fragment
        android:id="@+id/nav_transactions"
        android:name="yadetbashe.app.alisa.ui.fragments.TransactionsFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_transactions">
        <action
            android:id="@+id/action_transactions_to_personDetail"
            app:destination="@id/nav_person_detail" />
    </fragment>

    <fragment
        android:id="@+id/nav_people"
        android:name="yadetbashe.app.alisa.ui.fragments.PeopleFragment"
        android:label="@string/nav_people" />

    <fragment
        android:id="@+id/nav_reports"
        android:name="yadetbashe.app.alisa.ui.fragments.ReportsFragment"
        android:label="@string/nav_reports" />

    <fragment
        android:id="@+id/nav_settings"
        android:name="yadetbashe.app.alisa.ui.fragments.SettingsFragment"
        android:label="@string/nav_settings" />

    <fragment
        android:id="@+id/nav_person_detail"
        android:name="yadetbashe.app.alisa.ui.fragments.PersonDetailFragment"
        android:label="@string/transaction_history">
        <argument
            android:name="personId"
            app:argType="long" />
    </fragment>

    <action
        android:id="@+id/action_global_personDetail"
        app:destination="@id/nav_person_detail" />

</navigation>
